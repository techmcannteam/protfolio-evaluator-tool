DATABASE_URL=
DATABASE_PATH=evaluator.sqlite3
RENTCAST_API_KEY=
ATTOM_API_KEY=
ENABLE_ATTOM=false
ENABLE_FUB=false
RATE_LIMIT_PER_HOUR=20
PROVIDER_DAILY_CALL_LIMIT=30
IP_HASH_SALT=local-development-only
ALLOWED_ORIGINS=

# Server-only Google Places API (New) key for address suggestions
GOOGLE_PLACES_API_KEY=

# Delivery remains OFF until explicitly approved. No sender/recipient guesses.
ENABLE_EMAIL=false
ENABLE_TEAM_NOTIFICATIONS=false
EMAIL_FROM=
INTERNAL_NOTIFICATION_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
FUB_API_KEY=
FUB_SYSTEM=
FUB_SYSTEM_KEY=
# Katie has no verified FUB account. Leave blank; generic FUB deliveries are held.
FUB_GENERIC_ASSIGNEE_ID=
# Secret bearer token (at least 32 characters) for manual delivery recovery.
DELIVERY_ADMIN_TOKEN=
OWNER_EMAIL_DELAY_SECONDS=900
DELIVERY_RETRY_SECONDS=300
DELIVERY_MAX_ATTEMPTS=5
# Optional JSON override of config/expense-assumptions.json. Per-unit amounts are annual.
EXPENSE_ASSUMPTIONS_JSON={}
# Set only for an explicitly authorized Postgres smoke check; never committed.
PREVIEW_DATABASE_URL=
